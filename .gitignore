# Build da GDExtension — um diretório por alvo do godot-cpp (template_debug e
# template_release), por isso o curinga em vez dos nomes exatos.
libretrogd/build-*/
libretrogd/build/
libretrogd/.cache/
libretrogd/godot-cpp/

# Template de build Android (gerado ao instalar) e saída de export
app/android/
dist/

# Binários pré-compilados do addon de terceiros (copiados; não versionar)
app/addons/godotopenxrvendors/.bin/
app/bin/*.so
app/bin/*.dll
app/bin/*.dylib

# Cores libretro (binários, baixados pelo dev — não versionar)
cores/*.so
cores/*.dll
cores/*.dylib
app/cores/*.so
app/cores/*.dll

# ROMs — NUNCA versionar (direitos autorais; o usuário fornece as suas)
*.sfc
*.smc
*.n64
*.z64
*.nes
*.gba
*.bin
*.iso
*.chd

# Godot
app/.godot/
*.import

# Traduções compiladas: geradas do `ui.csv` pelo importador do Godot. O que se
# versiona é o CSV, que é o que uma pessoa edita; estes voltam a existir no
# primeiro `godot --import` (que a CI já roda antes dos testes).
app/traducoes/*.translation

# Chaves de assinatura — NUNCA versionar. Quem tem o arquivo assina atualizações
# como se fosse o projeto, e o Android não distingue uma da outra.
#
# A do release mora em `android/` (raiz do repo, não `app/android/`, que é o
# template de build gerado pelo Godot e some ao ser reinstalado). Ver "Assinar o
# release" em docs/EXPORT.md.
*.jks
*.keystore
# Senha da keystore, quando guardada em arquivo (ver tools/exportar-release.sh).
.senha-keystore

# Editores / SO
.DS_Store
*.swp
.vscode/
