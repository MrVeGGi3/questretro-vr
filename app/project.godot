; Projeto Godot — questretro-vr
; Fase 1: cena VR (OpenXR/Quest). A cena desktop (main.tscn) segue rodável.

config_version=5

[application]

config/name="QuestRetro"
run/main_scene="res://cenas/vr_main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://assets/icon.png"

[audio]

driver/enable_input=false

[rendering]

renderer/rendering_method="gl_compatibility"
; No Android quem manda é esta chave, não a de cima: sem ela o Godot cai no
; padrão (Vulkan/Mobile) e o Quest roda num renderer diferente do desktop.
; Precisa ser GL porque é o contexto do Godot que a GDExtension empresta ao
; core do N64 — ver "Renderização por hardware" em docs/EXPORT.md.
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true

[xr]

openxr/enabled=true
openxr/enabled.android=true
; Passthrough (modo Sala). Na Meta o passthrough não vem por blend mode nativo —
; o runtime só oferece OPAQUE, medido: `Sala: o runtime não oferece alpha blend
; (tem: [0])`. Quem o destrava é a extensão XR_FB_passthrough, que esta chave
; liga; com ela o ALPHA_BLEND passa a ser aceito.
openxr/extensions/meta/passthrough=true
shaders/enabled=true
shaders/enabled.android=true
